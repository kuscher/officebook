+package org.libreoffice.androidlib;
+
+import android.app.Activity;
+import android.content.ComponentName;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.DocumentsContract;
+import android.provider.OpenableColumns;
+import android.util.Log;
+import android.widget.Toast;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.URLDecoder;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * The desktop app's document actions, for the Android app on a PC: the
+ * starter screen and the backstage view (File tab) ask for them with
+ * GETRECENTDOCS, "opendoc", "newdoc" and "uno .uno:Open", which the
+ * Windows, macOS and Qt apps answer natively.
+ *
+ * The activity using it calls pickDocument() or newDocument(), passes its
+ * activity results to onActivityResult(), and opens the Uri it returns.
+ */
+public class DesktopDocuments {
+    private static final String TAG = "DesktopDocuments";
+
+    public static final int REQUEST_OPEN = 610;
+    public static final int REQUEST_NEW = 611;
+
+    private static final int MAX_RECENT_DOCUMENTS = 30;
+    /** As many as the desktop app lists (common/RecentFiles.cpp). */
+    private static final int MAX_RECENT_SHOWN = 15;
+
+    /** What Open offers, as the start screen's picker does. */
+    private static final String[] OPEN_MIME_TYPES = {
+        "application/vnd.oasis.opendocument.text",
+        "application/vnd.oasis.opendocument.graphics",
+        "application/vnd.oasis.opendocument.presentation",
+        "application/vnd.oasis.opendocument.spreadsheet",
+        "application/vnd.oasis.opendocument.text-flat-xml",
+        "application/vnd.oasis.opendocument.graphics-flat-xml",
+        "application/vnd.oasis.opendocument.presentation-flat-xml",
+        "application/vnd.oasis.opendocument.spreadsheet-flat-xml",
+        "application/vnd.oasis.opendocument.text-template",
+        "application/vnd.oasis.opendocument.spreadsheet-template",
+        "application/vnd.oasis.opendocument.graphics-template",
+        "application/vnd.oasis.opendocument.presentation-template",
+        "application/rtf",
+        "text/rtf",
+        "application/msword",
+        "application/vnd.ms-powerpoint",
+        "application/vnd.ms-excel",
+        "application/vnd.visio",
+        "application/vnd.visio.xml",
+        "application/x-mspublisher",
+        "application/vnd.ms-excel.sheet.binary.macroenabled.12",
+        "application/vnd.ms-excel.sheet.macroenabled.12",
+        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+        "application/vnd.openxmlformats-officedocument.presentationml.slideshow",
+        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+        "application/vnd.openxmlformats-officedocument.wordprocessingml.template",
+        "application/vnd.openxmlformats-officedocument.spreadsheetml.template",
+        "application/vnd.openxmlformats-officedocument.presentationml.template",
+        "text/csv",
+        "text/plain",
+        "text/comma-separated-values",
+        "application/vnd.ms-works",
+        "application/vnd.apple.keynote",
+        "application/x-abiword",
+        "application/x-pagemaker",
+        "image/x-emf",
+        "image/x-svm",
+        "image/x-wmf",
+        "image/svg+xml",
+        "application/pdf",
+    };
+
+    private final Activity mActivity;
+    /** The asset to copy into the document being created by REQUEST_NEW. */
+    private String mPendingAsset;
+
+    public DesktopDocuments(Activity activity) {
+        mActivity = activity;
+    }
+
+    /** "uno .uno:Open": let the user pick a document. */
+    public void pickDocument() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("*/*");
+        intent.putExtra(Intent.EXTRA_MIME_TYPES, OPEN_MIME_TYPES);
+        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION
+                | Intent.FLAG_GRANT_WRITE_URI_PERMISSION
+                | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+        mActivity.startActivityForResult(intent, REQUEST_OPEN);
+    }
+
+    /**
+     * "newdoc type=writer|calc|impress|draw [template=PATH] basename=NAME"
+     * (values URI-encoded): ask where to create the document, then fill it
+     * from the template, a path in the web UI's dist/ like
+     * templates/files/text/CV.odt, or from the blank document of that type.
+     */
+    public void newDocument(String parameters) {
+        String type = "writer";
+        String template = null;
+        String basename = null;
+        for (String token : parameters.split(" ")) {
+            int equals = token.indexOf('=');
+            if (equals < 0)
+                continue;
+            String key = token.substring(0, equals);
+            String value = decode(token.substring(equals + 1));
+            if (key.equals("type"))
+                type = value;
+            else if (key.equals("template"))
+                template = value;
+            else if (key.equals("basename"))
+                basename = value;
+        }
+
+        String extension = extensionForType(type);
+        if (template != null && template.startsWith("templates/") && !template.contains(".."))
+            mPendingAsset = "dist/" + template;
+        else
+            mPendingAsset = "dist/templates/" + blankTemplateForType(type);
+
+        if (basename == null || basename.isEmpty())
+            basename = "Untitled";
+
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType(mimeTypeForExtension(extension));
+        intent.putExtra(Intent.EXTRA_TITLE, basename + "." + extension);
+        mActivity.startActivityForResult(intent, REQUEST_NEW);
+    }
+
+    /** Whether onActivityResult() is for this requestCode. */
+    public boolean handles(int requestCode) {
+        return requestCode == REQUEST_OPEN || requestCode == REQUEST_NEW;
+    }
+
+    /** @return the document to open, or null (cancelled, or it failed). */
+    public Uri onActivityResult(int requestCode, int resultCode, Intent data) {
+        if (resultCode != Activity.RESULT_OK || data == null || data.getData() == null)
+            return null;
+
+        Uri uri = data.getData();
+        try {
+            mActivity.getContentResolver().takePersistableUriPermission(uri,
+                    Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        } catch (SecurityException e) {
+            Log.w(TAG, "No persistable permission for " + uri + ": " + e.getMessage());
+        }
+
+        if (requestCode == REQUEST_NEW && !copyAsset(mPendingAsset, uri)) {
+            Toast.makeText(mActivity, R.string.cant_open_the_document, Toast.LENGTH_SHORT).show();
+            return null;
+        }
+
+        addToRecents(mActivity, uri);
+        return uri;
+    }
+
+    private boolean copyAsset(String asset, Uri target) {
+        try (InputStream in = mActivity.getAssets().open(asset);
+             OutputStream out = mActivity.getContentResolver().openOutputStream(target, "wt")) {
+            byte[] buffer = new byte[65536];
+            int length;
+            while ((length = in.read(buffer)) > 0)
+                out.write(buffer, 0, length);
+            return true;
+        } catch (Exception e) {
+            Log.e(TAG, "Couldn't copy " + asset + " to " + target, e);
+            return false;
+        }
+    }
+
+    /** The intent that opens uri for editing in LOActivity. */
+    public static Intent intentToEdit(Context context, Uri uri) {
+        Intent intent = new Intent(Intent.ACTION_EDIT, uri);
+        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+        intent.setComponent(new ComponentName(context.getPackageName(), LOActivity.class.getName()));
+        return intent;
+    }
+
+    /** Put uri first in the recent documents the start screens show. */
+    public static void addToRecents(Context context, Uri uri) {
+        SharedPreferences prefs = context.getSharedPreferences(LOActivity.EXPLORER_PREFS_KEY, Context.MODE_PRIVATE);
+        List<String> recent = recentUris(prefs);
+        recent.remove(uri.toString());
+        recent.add(0, uri.toString());
+        while (recent.size() > MAX_RECENT_DOCUMENTS)
+            recent.remove(recent.size() - 1);
+        prefs.edit().putString(LOActivity.RECENT_DOCUMENTS_KEY, String.join("\n", recent)).apply();
+    }
+
+    private static List<String> recentUris(SharedPreferences prefs) {
+        List<String> uris = new ArrayList<>();
+        for (String line : prefs.getString(LOActivity.RECENT_DOCUMENTS_KEY, "").split("\n")) {
+            line = line.trim();
+            if (!line.isEmpty() && !uris.contains(line))
+                uris.add(line);
+        }
+        return uris;
+    }
+
+    /**
+     * GETRECENTDOCS: the recent documents that still exist, in the desktop
+     * app's format (common/RecentFiles.cpp), plus a readable displayUri for
+     * the path column and doctype for the icon.
+     */
+    public static String recentDocsJson(Context context) {
+        SharedPreferences prefs = context.getSharedPreferences(LOActivity.EXPLORER_PREFS_KEY, Context.MODE_PRIVATE);
+        ContentResolver resolver = context.getContentResolver();
+        SimpleDateFormat iso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US);
+        iso.setTimeZone(TimeZone.getTimeZone("UTC"));
+        JSONArray documents = new JSONArray();
+        for (String uriString : recentUris(prefs)) {
+            if (documents.length() >= MAX_RECENT_SHOWN)
+                break;
+            Uri uri = Uri.parse(uriString);
+            String name = null;
+            long modified = 0;
+            try (Cursor cursor = resolver.query(uri, null, null, null, null)) {
+                if (cursor == null || !cursor.moveToFirst())
+                    continue;
+                int nameColumn = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                int modifiedColumn = cursor.getColumnIndex(DocumentsContract.Document.COLUMN_LAST_MODIFIED);
+                if (nameColumn >= 0)
+                    name = cursor.getString(nameColumn);
+                if (modifiedColumn >= 0 && !cursor.isNull(modifiedColumn))
+                    modified = cursor.getLong(modifiedColumn);
+            } catch (Exception e) {
+                // Gone, or we lost the permission: leave it out, as the
+                // desktop app leaves out files that no longer exist.
+                continue;
+            }
+            if (name == null)
+                name = uri.getLastPathSegment();
+            try {
+                JSONObject document = new JSONObject();
+                document.put("uri", uriString);
+                document.put("name", name);
+                document.put("displayUri", "file://" + Uri.encode(displayPath(uri, name), "/"));
+                document.put("doctype", docTypeForName(name));
+                if (modified > 0)
+                    document.put("timestamp", iso.format(new Date(modified)));
+                documents.put(document);
+            } catch (JSONException e) {
+                Log.w(TAG, "Leaving out " + uriString + ": " + e.getMessage());
+            }
+        }
+        return documents.toString();
+    }
+
+    /**
+     * Where the document is, as a path to show: /Download/Letter.odt for
+     * shared storage (a "primary:Download/Letter.odt" document id), else just
+     * the name.
+     */
+    private static String displayPath(Uri uri, String name) {
+        try {
+            if (DocumentsContract.isDocumentUri(null, uri)) {
+                String id = DocumentsContract.getDocumentId(uri);
+                int colon = id.indexOf(':');
+                if (colon >= 0 && "com.android.externalstorage.documents".equals(uri.getAuthority()))
+                    return "/" + id.substring(colon + 1);
+            }
+        } catch (IllegalArgumentException e) {
+            // not a document URI
+        }
+        return "/" + name;
+    }
+
+    private static String decode(String value) {
+        try {
+            return URLDecoder.decode(value, "UTF-8");
+        } catch (Exception e) {
+            return value;
+        }
+    }
+
+    public static String extensionForType(String type) {
+        switch (type) {
+            case "calc": return "ods";
+            case "impress": return "odp";
+            case "draw": return "odg";
+            default: return "odt";
+        }
+    }
+
+    private static String blankTemplateForType(String type) {
+        switch (type) {
+            case "calc": return "Spreadsheet.ods";
+            case "impress": return "Presentation.odp";
+            case "draw": return "Drawing.odg";
+            default: return "TextDocument.odt";
+        }
+    }
+
+    private static String mimeTypeForExtension(String extension) {
+        switch (extension) {
+            case "ods": return "application/vnd.oasis.opendocument.spreadsheet";
+            case "odp": return "application/vnd.oasis.opendocument.presentation";
+            case "odg": return "application/vnd.oasis.opendocument.graphics";
+            default: return "application/vnd.oasis.opendocument.text";
+        }
+    }
+
+    private static String docTypeForName(String name) {
+        String lower = name.toLowerCase(Locale.ROOT);
+        if (lower.matches(".*\\.(ods|fods|ots|xls|xlsx|xlsm|xlsb|csv)$"))
+            return "calc";
+        if (lower.matches(".*\\.(odp|fodp|otp|ppt|pptx|pps|ppsx|key)$"))
+            return "impress";
+        if (lower.matches(".*\\.(odg|fodg|otg|vsd|vsdx|svg)$"))
+            return "draw";
+        if (lower.endsWith(".pdf"))
+            return "pdf";
+        return "writer";
+    }
+}
