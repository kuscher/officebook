+package org.libreoffice.androidapp.ui;
+
+import android.content.ActivityNotFoundException;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.res.Configuration;
+import android.graphics.Insets;
+import android.graphics.drawable.ColorDrawable;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.util.Log;
+import android.view.ViewGroup;
+import android.view.WindowInsets;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.appcompat.app.AppCompatDelegate;
+import androidx.preference.PreferenceManager;
+
+import org.libreoffice.androidlib.COWebView;
+import org.libreoffice.androidlib.DesktopDocuments;
+import org.libreoffice.androidlib.LOActivity;
+
+import java.util.Locale;
+
+/**
+ * The start screen on a PC: the desktop app's starter screen (the web UI's
+ * backstage view in starter mode, with the recent documents, New from the
+ * templates, and Open), in place of LibreOfficeUIActivity's list. It needs
+ * no document and no COOLWSD: it answers the few messages the starter
+ * screen sends, and opens documents in LOActivity.
+ */
+public class StarterActivity extends AppCompatActivity {
+    private static final String TAG = "StarterActivity";
+
+    private COWebView mWebView;
+    private DesktopDocuments mDocuments;
+    private boolean mDarkMode;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        mDocuments = new DesktopDocuments(this);
+
+        mWebView = new COWebView(this);
+        setContentView(mWebView);
+
+        // Below the system bars and the caption bar; the window's background,
+        // the web UI's own, shows under the (transparent) caption bar.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            mWebView.setOnApplyWindowInsetsListener((v, windowInsets) -> {
+                Insets insets = windowInsets.getInsets(WindowInsets.Type.systemBars());
+                ViewGroup.MarginLayoutParams margins = (ViewGroup.MarginLayoutParams) v.getLayoutParams();
+                margins.setMargins(insets.left, insets.top, insets.right, insets.bottom);
+                v.setLayoutParams(margins);
+                return WindowInsets.CONSUMED;
+            });
+        }
+
+        WebSettings settings = mWebView.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        if (PreferenceManager.getDefaultSharedPreferences(this).getBoolean("ENABLE_CHROME_DEBUGGING", false))
+            WebView.setWebContentsDebuggingEnabled(true);
+        mWebView.addJavascriptInterface(new Host(), "COOLMessageHandler");
+
+        load();
+    }
+
+    private void load() {
+        mDarkMode = isDarkMode();
+        getWindow().setBackgroundDrawable(new ColorDrawable(mDarkMode ? 0xFF121212 : 0xFFF8F9FA));
+        LOActivity.useTransparentCaptionBar(this, mDarkMode);
+
+        String language = getResources().getConfiguration().getLocales().get(0).toLanguageTag();
+        mWebView.loadUrl("file:///android_asset/dist/cool.html?starterMode=true"
+                + "&lang=" + Uri.encode(language)
+                + "&darkTheme=" + mDarkMode
+                + "&userinterfacemode=notebookbar");
+    }
+
+    @Override
+    protected void onRestart() {
+        super.onRestart();
+        // Back from a document: show it among the recent ones, in the theme
+        // it may have switched to.
+        load();
+    }
+
+    @Override
+    public void onConfigurationChanged(Configuration newConfig) {
+        super.onConfigurationChanged(newConfig);
+        if (isDarkMode() != mDarkMode)
+            load();
+    }
+
+    /** The app's dark mode setting (the start screen's, or the web UI's SETDARKMODE). */
+    private boolean isDarkMode() {
+        SharedPreferences prefs = getSharedPreferences(LOActivity.EXPLORER_PREFS_KEY, MODE_PRIVATE);
+        int mode = prefs.getInt(LOActivity.NIGHT_MODE_KEY, AppCompatDelegate.MODE_NIGHT_FOLLOW_SYSTEM);
+        if (mode == AppCompatDelegate.MODE_NIGHT_YES)
+            return true;
+        if (mode == AppCompatDelegate.MODE_NIGHT_NO)
+            return false;
+        return (getResources().getConfiguration().uiMode & Configuration.UI_MODE_NIGHT_MASK)
+                == Configuration.UI_MODE_NIGHT_YES;
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (mDocuments.handles(requestCode)) {
+            Uri document = mDocuments.onActivityResult(requestCode, resultCode, data);
+            if (document != null)
+                open(document);
+        }
+    }
+
+    private void open(Uri uri) {
+        DesktopDocuments.addToRecents(this, uri);
+        startActivity(DesktopDocuments.intentToEdit(this, uri));
+    }
+
+    @Override
+    protected void onDestroy() {
+        if (mWebView != null) {
+            mWebView.destroy();
+            mWebView = null;
+        }
+        super.onDestroy();
+    }
+
+    /** What the starter screen asks of the app (window.COOLMessageHandler). */
+    private class Host {
+        @JavascriptInterface
+        public boolean isChromeOS() {
+            return LOActivity.isDesktop(StarterActivity.this);
+        }
+
+        @JavascriptInterface
+        public boolean isCODesktop() {
+            return LOActivity.isDesktop(StarterActivity.this);
+        }
+
+        @JavascriptInterface
+        public boolean hasHardwareKeyboard() {
+            return getResources().getConfiguration().keyboard != Configuration.KEYBOARD_NOKEYS;
+        }
+
+        @JavascriptInterface
+        public String postMobileCall(String message) {
+            if (message.equals("GETRECENTDOCS"))
+                return DesktopDocuments.recentDocsJson(StarterActivity.this);
+            postMobileMessage(message);
+            return null;
+        }
+
+        @JavascriptInterface
+        public void postMobileMessage(String message) {
+            String[] commandAndParameters = message.split(" ", 2);
+            String parameters = commandAndParameters.length > 1 ? commandAndParameters[1] : "";
+            switch (commandAndParameters[0]) {
+                case "opendoc":
+                    // "opendoc file=<URI-encoded uri>": a recent document
+                    if (parameters.startsWith("file=")) {
+                        final Uri uri = Uri.parse(Uri.decode(parameters.substring(5)));
+                        runOnUiThread(() -> open(uri));
+                    }
+                    break;
+                case "newdoc":
+                    runOnUiThread(() -> mDocuments.newDocument(parameters));
+                    break;
+                case "uno":
+                    if (parameters.equals(".uno:Open"))
+                        runOnUiThread(() -> mDocuments.pickDocument());
+                    break;
+                case "SETDARKMODE": {
+                    boolean dark = parameters.equals("true");
+                    getSharedPreferences(LOActivity.EXPLORER_PREFS_KEY, MODE_PRIVATE).edit()
+                            .putInt(LOActivity.NIGHT_MODE_KEY,
+                                    dark ? AppCompatDelegate.MODE_NIGHT_YES : AppCompatDelegate.MODE_NIGHT_NO)
+                            .apply();
+                    runOnUiThread(() -> LOActivity.useTransparentCaptionBar(StarterActivity.this, dark));
+                    break;
+                }
+                case "HYPERLINK":
+                    runOnUiThread(() -> {
+                        try {
+                            startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(parameters)));
+                        } catch (ActivityNotFoundException e) {
+                            Log.w(TAG, "Nothing opens " + parameters);
+                        }
+                    });
+                    break;
+                default:
+                    // The starter screen has no document: the rest (the fake
+                    // socket's greeting, for one) has nowhere to go.
+                    Log.d(TAG, "postMobileMessage ignored: " + commandAndParameters[0]);
+                    break;
+            }
+        }
+
+        @JavascriptInterface
+        public void postMobileError(String message) {
+            Log.e(TAG, "web UI: " + message);
+        }
+
+        @JavascriptInterface
+        public void postMobileDebug(String message) {
+            Log.d(TAG, "web UI: " + message);
+        }
+    }
+}
