diff --git a/browser/js/global.js b/browser/js/global.js
index 16e9faa2b..5cab59fb3 100644
--- a/browser/js/global.js
+++ b/browser/js/global.js
@@ -84,6 +84,8 @@ class BrowserProperties {
 		// Decided on first use, not here: this runs from InitializerBase's
 		// constructor, before AndroidAppInitializer sets ThisIsTheAndroidApp.
 		var chromebook;
+		// Likewise whether the Android app runs as the desktop app (on a PC).
+		var androidDesktopApp;
 
 		var navigatorLang = navigator.languages && navigator.languages.length ? navigator.languages[0] :
 		(navigator.language || navigator.userLanguage || navigator.browserLanguage || navigator.systemLanguage);
@@ -207,7 +209,14 @@ class BrowserProperties {
 				return global.L.Browser.mobile && !global.mode.isSmallScreenDevice();
 			},
 			isCODesktop: function() {
-				return global.ThisIsTheMacOSApp || global.ThisIsTheQtApp || global.ThisIsTheWindowsApp;
+				if (global.ThisIsTheMacOSApp || global.ThisIsTheQtApp || global.ThisIsTheWindowsApp)
+					return true;
+				// The Android app on a PC (ChromeOS, Android's desktop mode) is the
+				// desktop app too, if it says so.
+				if (androidDesktopApp === undefined && global.ThisIsTheAndroidApp)
+					androidDesktopApp = typeof global.COOLMessageHandler.isCODesktop === 'function'
+						&& !!global.COOLMessageHandler.isCODesktop();
+				return !!androidDesktopApp;
 			},
 			isDesktop: function() {
 				if (global.ThisIsTheWindowsApp || global.ThisIsTheQtApp	|| global.ThisIsTheMacOSApp)
@@ -627,7 +636,11 @@ class AndroidAppInitializer extends MobileAppInitializer {
 
 		window.ThisIsTheAndroidApp = true;
 		window.postMobileMessage = function(msg) { window.COOLMessageHandler.postMobileMessage(msg); };
-		window.postMobileCall    = window.postMobileMessage;
+		// postMobileCall returns the app's answer (a string, or null); older apps
+		// only have postMobileMessage.
+		window.postMobileCall    = typeof window.COOLMessageHandler.postMobileCall === 'function'
+			? function(msg) { return window.COOLMessageHandler.postMobileCall(msg); }
+			: window.postMobileMessage;
 		window.postMobileError   = function(msg) { window.COOLMessageHandler.postMobileError(msg); };
 		window.postMobileDebug   = function(msg) { window.COOLMessageHandler.postMobileDebug(msg); };
 
@@ -2232,7 +2245,10 @@ function showWelcomeSVG() {
 
 	// Create a WebSocket to the server
 	// FIXME The Android and iOS apps use the new approach, other apps should follow
-	if (global.ThisIsAMobileApp && !global.ThisIsTheAndroidApp && !global.ThisIsTheiOSApp) {
+	// The Android app's starter screen has no document, so no socket to talk to
+	// either: use the FakeWebSocket, as the desktop apps do.
+	if ((global.ThisIsAMobileApp && !global.ThisIsTheAndroidApp && !global.ThisIsTheiOSApp)
+	    || (global.ThisIsTheAndroidApp && window.starterScreen)) {
 		// FIXME Remove FakeWebSocket when the mobile apps are updated to use the new approach
 		global.socket = new global.FakeWebSocket();
 		global.TheFakeWebSocket = global.socket;
